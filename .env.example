# Credenciales para la YouTube Data API v3 (OAuth2).
# Copia este archivo a .env solo para pruebas LOCALES (no lo subas al repo).
# En Claude Code on the web, configura estas mismas variables en el ENTORNO.

# OAuth Client ID (tipo Desktop) de Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Refresh token generado con: python scripts/get_refresh_token.py <client_secret.json>
GOOGLE_REFRESH_TOKEN=

# ID de tu playlist dedicada "Por ver".
# Lo encuentras en la URL de la playlist: ...?list=PLxxxxxxxxxxxx  (el valor PL...)
YOUTUBE_PLAYLIST_ID=
